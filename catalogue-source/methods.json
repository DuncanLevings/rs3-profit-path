          "key": "smelts_per_hour",
          "unit": "smelts/hour",
          "default": 2000
        },
        "inputs": [
          {
            "item_id": 440,
            "name": "Iron ore",
            "quantity": 1,
            "basis": "action"
          },
          {
            "item_id": 453,
            "name": "Coal",
